# ============================================================
# ShopNTrust Environment Variables — Example File
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# --- n8n Integration ---
# The webhook URL for the AI Agent workflow in n8n.
NEXT_PUBLIC_N8N_AGENT_WEBHOOK_URL=https://your-n8n-instance.com/webhook/agent

# The webhook URL for the Payment workflow in n8n.
NEXT_PUBLIC_N8N_PAYMENT_WEBHOOK_URL=https://your-n8n-instance.com/webhook/payment

# --- Supabase Real Auth & Database ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Optional: Future n8n endpoints ---
# NEXT_PUBLIC_N8N_ORDER_WEBHOOK_URL=https://your-n8n-instance.com/webhook/order
